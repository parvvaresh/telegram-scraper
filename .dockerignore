# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Session files (contain auth tokens — do not commit)
session/*.session

# Output and temp data
output/
logs/

# Environment / IDE
.env
.venv/
.idea/
.vscode/
*.swp
*.swo

# Docker volumes
clickhouse_data/
clickhouse_logs/

# Frontend build artifacts (built inside the image)
frontend/node_modules/
frontend/dist/

# Local settings (mounted at runtime)
input/settings.json
